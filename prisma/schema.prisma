generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Solicitacao {
  id                Int             @id @unique @default(autoincrement())
  nome              String          @db.VarChar(255)
  email             String          @db.VarChar(100)
  cpf               String          @db.VarChar(14)
  telefone          String?         @db.VarChar(15)
  telefone2         String?         @db.VarChar(15)
  dt_nascimento     DateTime?
  id_fcw            Int?
  cnh               String?         @db.VarChar(20)
  ativo             Boolean         @default(true)
  rela_quest        Boolean         @default(false)
  distrato          Boolean         @default(false)
  dt_distrato       DateTime?
  status_aprovacao  Boolean?        @default(false)
  distrato_id       Int?
  andamento         String?         @db.VarChar(100)
  type_validacao    String?         @db.VarChar(50)
  dt_aprovacao      DateTime?       @db.Date
  hr_aprovacao      DateTime?       @db.Time(6)
  dt_agendamento    DateTime?       @db.Date
  hr_agendamento    DateTime?       @db.Time(6)
  estatos_pgto      String?         @db.VarChar(50)
  valorcd           Float?
  situacao_pg       Int?            @default(0)
  freqSms           Int?            @default(0)
  alertanow         Boolean?        @default(false)
  dt_criacao_now    DateTime?
  statusAtendimento Boolean         @default(false)
  pause             Boolean?        @default(false)
  corretorId        Int?
  construtoraId     Int?
  financeiroId      Int?
  empreendimentoId  Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime?       @updatedAt
  relacionamentos   Json[]
  dt_revogacao      DateTime?
  direto            Boolean         @default(false)
  txid              String?         @db.VarChar(300)
  pixCopiaECola     String?
  imagemQrcode      String?
  uploadCnh         Json?
  uploadRg          Json?
  obs               Json[]
  pg_andamento      String?         @default("pendente") @db.VarChar(50)
  pg_date           DateTime?
  pg_status         Boolean?        @default(false)
  sisapp            Boolean         @default(false)
  gov               Boolean         @default(false)
  conf_devolucao    Boolean         @default(false)
  dt_conf_devolucao DateTime?
  fcweb_unico       String?
  inovstarContactId String?         @db.VarChar(100)
  alerts            Alert[]
  Direto            Direto[]
  construtora       Construtora?    @relation("ConstrutoraSolicitacoes", fields: [construtoraId], references: [id])
  corretor          User?           @relation("CorretorSolicitacoes", fields: [corretorId], references: [id])
  empreendimento    Empreendimento? @relation("EmpreendimentoSolicitacoes", fields: [empreendimentoId], references: [id])
  financeiro        Financeiro?     @relation("FinanceiraSolicitacoes", fields: [financeiroId], references: [id])
  tags              Tag[]
  vouchers          Voucher[]
  chatClientes      ChatClienteSolicitacao[]
  chatConversas     ChatConversa[]

  @@index([email], map: "idx_solicitacao_email")
  @@index([txid], map: "idx_solicitacao_txid")
  @@index([cpf])
  @@index([corretorId])
  @@index([construtoraId])
  @@index([financeiroId])
  @@index([empreendimentoId])
  @@index([andamento])
}

model User {
  id                        Int                  @id @unique @default(autoincrement())
  username                  String               @unique @db.VarChar(50)
  password                  String               @db.VarChar(255)
  password_key              String               @db.VarChar(100)
  telefone                  String?              @db.VarChar(15)
  email                     String?              @unique @db.VarChar(100)
  cpf                       String?              @db.VarChar(14)
  nome                      String?              @db.VarChar(255)
  cargo                     String?              @db.VarChar(100)
  hierarquia                String?              @db.VarChar(100)
  reset_password            Boolean?             @default(true)
  status                    Boolean?             @default(false)
  sms_relat                 Boolean?             @default(false)
  termos                    Boolean?             @default(false)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime?            @updatedAt
  role                      Json?
  reset_password_expires    DateTime?
  reset_password_token      String?              @unique @db.VarChar(255)
  Alert                     Alert[]
  responsavelEmpreendimento Empreendimento[]     @relation("EmpreendimentoResponsavel")
  Intelesign                Intelesign[]
  solicitacoes              Solicitacao[]        @relation("CorretorSolicitacoes")
  construtoras              UserConstrutora[]
  empreendimentos           UserEmpreendimento[]
  financeiros               UserFinanceiro[]
  imobiliarias              UserImobiliaria[]
  userlogins                Userlogin[]
  voucherLogs               VoucherLog[]
  chatConversasAtendidas    ChatConversa[]       @relation("ChatAtendente")
  chatConversasFinalizadas  ChatConversa[]       @relation("ChatFinalizadaPor")
  chatMensagens             ChatMensagem[]       @relation("ChatMensagemAtendente")
  chatMidias                ChatMidia[]          @relation("ChatMidiaAtendente")
  chatVerificacoes          ChatVerificacao[]    @relation("ChatVerificacaoSolicitante")

  @@index([username], map: "idx_user_username")
  @@index([email], map: "idx_user_email")
  @@index([cpf], map: "idx_user_cpf")
  @@index([reset_password_token], map: "idx_user_reset_token")
}

model Construtora {
  id                   Int                     @id @unique @default(autoincrement())
  cnpj                 String                  @unique @db.VarChar(18)
  razaosocial          String                  @db.VarChar(255)
  fantasia             String?                 @db.VarChar(255)
  tel                  String?                 @db.VarChar(15)
  email                String?                 @db.VarChar(100)
  obs                  String?
  status               Boolean                 @default(true)
  valor_cert           Float?                  @default(84.00)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime?               @updatedAt
  atividade            String?                 @db.VarChar(100)
  Msg_Boas_Vindas      String?
  responsavel          String?
  Intelesign_price     Float?                  @default(0)
  Intelesign_status    Boolean                 @default(false)
  empreendimentos      Empreendimento[]
  financeiros          FinanceiroConstrutora[]
  Intelesign           Intelesign[]
  solicitacoes         Solicitacao[]           @relation("ConstrutoraSolicitacoes")
  colaboradores        UserConstrutora[]
  relatorio_financeiro relatorio_financeiro[]
  relatorio_natosign   relatorio_natosign[]

  @@index([cnpj], map: "idx_construtora_cnpj")
  @@index([razaosocial], map: "idx_construtora_razaosocial")
}

model Imobiliaria {
  id            Int               @id @unique @default(autoincrement())
  cnpj          String            @unique @db.VarChar(18)
  razaosocial   String            @db.VarChar(255)
  fantasia      String?           @db.VarChar(255)
  tel           String?           @db.VarChar(15)
  email         String?           @db.VarChar(100)
  obs           String?
  status        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime?         @updatedAt
  // Relação inversa de Intelesign.imobiliaria_id (não gera coluna no banco)
  Intelesign    Intelesign[]
  colaboradores UserImobiliaria[]

  @@index([cnpj], map: "idx_imobiliaria_cnpj")
  @@index([razaosocial], map: "idx_imobiliaria_razaosocial")
}

model Financeiro {
  id                Int                        @id @unique @default(autoincrement())
  cnpj              String                     @unique @db.VarChar(18)
  razaosocial       String                     @db.VarChar(255)
  fantasia          String?                    @db.VarChar(255)
  tel               String?
  email             String?                    @db.VarChar(100)
  obs               String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime?                  @updatedAt
  direto            Boolean                    @default(false)
  responsavel       String?
  valor_cert        Float?                     @default(0)
  Intelesign_status Boolean                    @default(false)
  Intelesign_price  Float?                     @default(0)
  status            Boolean                    @default(true)
  construtoras      FinanceiroConstrutora[]
  empreendimento    FinanceiroEmpreendimento[]
  Intelesign        Intelesign[]
  solicitacoes      Solicitacao[]              @relation("FinanceiraSolicitacoes")
  colaboradores     UserFinanceiro[]
  relatorioNatosign relatorio_natosign[]

  @@index([cnpj], map: "idx_financeiro_cnpj")
  @@index([razaosocial], map: "idx_financeiro_razaosocial")
}

model Empreendimento {
  id                   Int                        @id @unique @default(autoincrement())
  nome                 String                     @db.VarChar(255)
  endereco             String?                    @db.VarChar(255)
  cidade               String?                    @db.VarChar(100)
  estado               String?                    @db.VarChar(2)
  cep                  String?                    @db.VarChar(10)
  obs                  String?
  status               Boolean                    @default(true)
  tag                  String?                    @db.VarChar(50)
  construtoraId        Int?
  responsavelId        Int?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime?                  @updatedAt
  direto               Boolean                    @default(false)
  valor_cert           Float?                     @default(0)
  templateSms          String?                    @db.VarChar(100)
  customVar2           String?                    @db.VarChar(100)
  customVar3           String?                    @db.VarChar(100)
  customVar4           String?                    @db.VarChar(100)
  Intelesign_status    Boolean                    @default(false)
  Intelesign           Intelesign[]
  construtora          Construtora?               @relation(fields: [construtoraId], references: [id])
  responsavel          User?                      @relation("EmpreendimentoResponsavel", fields: [responsavelId], references: [id])
  financeiros          FinanceiroEmpreendimento[]
  Solicitacao          Solicitacao[]              @relation("EmpreendimentoSolicitacoes")
  colaboradores        UserEmpreendimento[]
  relatorio_financeiro relatorio_financeiro[]

  @@index([nome], map: "idx_empreendimento_nome")
  @@index([cidade, estado], map: "idx_empreendimento_localizacao")
  @@index([construtoraId])
}

model Alert {
  id             Int          @id @unique @default(autoincrement())
  solicitacao_id Int?
  status         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  descricao      String
  corretor_id    Int?
  lido           Boolean      @default(false)
  corretor       User?        @relation(fields: [corretor_id], references: [id], onUpdate: SetNull)
  solicitacao    Solicitacao? @relation(fields: [solicitacao_id], references: [id], onUpdate: SetNull)

  @@index([solicitacao_id])
  @@index([corretor_id])
}

model Suporte {
  id          Int       @id @unique @default(autoincrement())
  tag         String
  descricao   String?
  solicitacao Int?
  imgSuspensa String?
  createAt    DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  urlveiw     Json[]
}

model Tag {
  id              Int          @id @default(autoincrement())
  solicitacao     Int?
  descricao       String?
  createAt        DateTime     @default(now())
  solicitacaoData Solicitacao? @relation(fields: [solicitacao], references: [id], onDelete: NoAction, onUpdate: SetNull)
}

model TagList {
  id        Int      @id @unique @default(autoincrement())
  label     String
  createdAt DateTime @default(now())
}

model Chamado {
  id            Int       @id @unique @default(autoincrement())
  descricao     String
  status        String
  idUser        Int
  createAt      DateTime  @default(now())
  updatedAt     DateTime? @updatedAt
  solicitacaoId Int
  images        Json[]
  chat          Json[]
  temp          Json[]
  departamento  String?   @default("vendas")
  dth_qru       DateTime  @default(now())
  prioridade    String?   @default("baixa")
  titulo        String
}

model relatorio_financeiro {
  id               Int             @id @unique @default(autoincrement())
  protocolo        String          @unique
  situacao_pg      Int             @default(0)
  nota_fiscal      String?         @db.VarChar(255)
  start            DateTime?       @db.Date
  end              DateTime?       @db.Date
  statusNota       Boolean?        @default(false)
  createAt         DateTime        @default(now())
  updatedAt        DateTime?       @updatedAt
  construtoraId    Int?
  total_cert       Int?
  valorTotal       Float?
  solicitacao      Json[]          @default([])
  pdf              String?         @db.VarChar(255)
  xlsx             String?         @db.VarChar(255)
  modelo           String?
  empreendimentoId Int?
  dt_pg            DateTime?
  status           Boolean         @default(true)
  Type             String          @default("certificado")
  construtora      Construtora?    @relation(fields: [construtoraId], references: [id], onDelete: NoAction, onUpdate: SetNull)
  Empreendimento   Empreendimento? @relation(fields: [empreendimentoId], references: [id], onDelete: NoAction, onUpdate: SetNull)
}

// Cobrança dos envelopes NatoSign: cobra uma construtora OU uma CCA por período
model relatorio_natosign {
  id              Int          @id @unique @default(autoincrement())
  protocolo       String       @unique
  situacao_pg     Int          @default(0) // 0 em análise, 1 pendente, 2 pago
  nota_fiscal     String?      @db.VarChar(255)
  start           DateTime?    @db.Date
  end             DateTime?    @db.Date
  total_envelopes Int          @default(0)
  valorTotal      Float        @default(0)
  empreendimentos Json[]       @default([]) // retrato dos envelopes cobrados, por empreendimento
  pdf             String?      @db.VarChar(255)
  xlsx            String?      @db.VarChar(255)
  dt_pg           DateTime?
  status          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime?    @updatedAt
  construtoraId   Int?
  financeiroId    Int?
  construtora     Construtora? @relation(fields: [construtoraId], references: [id], onDelete: NoAction)
  financeiro      Financeiro?  @relation(fields: [financeiroId], references: [id], onDelete: NoAction)
  envelopes       Intelesign[]

  @@index([construtoraId])
  @@index([financeiroId])
}

model UserEmpreendimento {
  userId           Int
  empreendimentoId Int
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, empreendimentoId])
  @@index([empreendimentoId])
  @@index([userId])
}

model UserConstrutora {
  userId        Int
  construtoraId Int
  construtora   Construtora @relation(fields: [construtoraId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, construtoraId])
  @@index([construtoraId])
  @@index([userId])
}

model UserFinanceiro {
  userId       Int
  financeiroId Int
  financeiro   Financeiro @relation(fields: [financeiroId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, financeiroId])
  @@index([financeiroId])
  @@index([userId])
}

model UserImobiliaria {
  userId        Int
  imobiliariaId Int
  imobiliaria   Imobiliaria @relation(fields: [imobiliariaId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, imobiliariaId])
  @@index([imobiliariaId])
  @@index([userId])
}

model FinanceiroEmpreendimento {
  financeiroId     Int
  empreendimentoId Int
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  financeiro       Financeiro     @relation(fields: [financeiroId], references: [id], onDelete: Cascade)

  @@id([empreendimentoId, financeiroId])
}

model FinanceiroConstrutora {
  financeiroId  Int
  construtoraId Int
  construtora   Construtora @relation(fields: [construtoraId], references: [id])
  financeiro    Financeiro  @relation(fields: [financeiroId], references: [id])

  @@id([construtoraId, financeiroId])
}

model Logs {
  id        Int       @id @unique @default(autoincrement())
  User      Int
  EffectId  Int
  descricao String
  createAt  DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  rota      String
}

model Termo {
  id        Int       @id @unique @default(autoincrement())
  termo     String
  politica  String
  createAt  DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Bug {
  id        Int       @id @unique @default(autoincrement())
  descricao String
  status    Boolean   @default(true)
  createAt  DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model SystemMessage {
  id        Int       @id @unique @default(autoincrement())
  tipo      String
  message   String
  createAt  DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model VideosFaq {
  id       Int      @id @unique @default(autoincrement())
  nome     String
  url      String
  createAt DateTime @default(now())
  tag      String
}

model Direto {
  id            Int          @id @default(autoincrement())
  solicitacaoId Int?
  descricao     String?
  createAt      DateTime     @default(now())
  Solicitacao   Solicitacao? @relation(fields: [solicitacaoId], references: [id])
  DiretoTag     DiretoTag[]
}

model DiretoTag {
  id        Int      @id @default(autoincrement())
  diretoId  Int
  descricao String
  createAt  DateTime @default(now())
  Direto    Direto   @relation(fields: [diretoId], references: [id], onDelete: Cascade)
}

model Intelesign {
  id                  Int                    @id @unique @default(autoincrement())
  UUID                String?
  status              String?                @default("new")
  doc_original_viw    String?
  doc_original_down   String?
  doc_modificado_viw  String?
  doc_modificado_down String?
  original_name       String?
  hash                String?
  valor               Float?                 @default(5)
  cca_id              Int?
  status_pg           String                 @default("pending")
  createdAt           DateTime               @default(now())
  status_view         String                 @default("Novo")
  updatedAt           DateTime?              @updatedAt
  ativo               Boolean                @default(true)
  construtora_id      Int?
  empreendimento_id   Int?
  imobiliaria_id      Int?
  user_id             Int?
  description         String
  message             String
  title               String
  type                String
  background_sheet    String?
  public_link         String?
  // Cancelamento só no SisNato (a Intellisign não é avisada)
  cancelado_em        DateTime?
  cancelado_por       String?
  motivo_cancelamento String?
  // Pedido de cancelamento, confirmado depois pelo ADM responsável
  // (role.natosign_confirmar_cancelamento) após cancelar na Intellisign
  cancelamento_solicitado_em     DateTime?
  cancelamento_solicitado_por    String?
  cancelamento_solicitado_por_id Int?
  // Cobrança: status_pg vai de pending -> billed (entrou num relatório) -> paid
  relatorio_natosign_id Int?
  cca                 Financeiro?            @relation(fields: [cca_id], references: [id], onDelete: Cascade)
  contrutora          Construtora?           @relation(fields: [construtora_id], references: [id], onDelete: Cascade)
  empreendimento      Empreendimento?        @relation(fields: [empreendimento_id], references: [id], onDelete: Cascade) // <--- RELAÇÃO ADICIONADA
  imobiliaria         Imobiliaria?           @relation(fields: [imobiliaria_id], references: [id], onDelete: SetNull)
  user                User?                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  signatarios         IntelesignSignatario[]
  relatorio_natosign  relatorio_natosign?    @relation(fields: [relatorio_natosign_id], references: [id], onDelete: SetNull)

  @@index([imobiliaria_id])
  @@index([relatorio_natosign_id])
}

model IntelesignSignatario {
  id          Int         @id @unique @default(autoincrement())
  UUID        String?
  nome        String
  email       String
  state       String?     @default("in-transit")
  filled_at   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?   @updatedAt
  cpf         String
  telefone    String?     @db.VarChar(13) // só dígitos, com 55; usado para notificar por WhatsApp
  qualificacao String?    @db.VarChar(120) // papel no contrato (ex.: Testemunha); sai no manifesto
  ordem       Int?        // routing_order na Intellisign (1 = primeiro a assinar)
  envelope_id Int?
  Intelesign  Intelesign? @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
}

model AppToken {
  id           Int       @id @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  access_token String
  expires_in   Int

  @@map("app_token")
}

model ContactMessages {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String
  empresa   String?
  mensagem  String
  createdAt DateTime @default(now())
}

model Userlogin {
  id          Int      @id @default(autoincrement())
  nome        String
  ip          String
  createdAt   DateTime @default(now())
  geolocation Json
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model Estado {
  id      Int      @id
  nome    String   @db.VarChar(50)
  sigla   String   @db.VarChar(2)
  cidades Cidade[]

  @@map("estados")
}

model Cidade {
  id           Int          @id @default(autoincrement())
  codigo_ibge  Int          @unique
  nome         String       @db.VarChar(255)
  latitude     Float
  longitude    Float
  capital      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime?    @updatedAt
  codigo_uf    Int
  ddd          Int?
  fuso_horario String?      @db.VarChar(100)
  siafi_id     Int?
  arParceiras  ArParceira[]
  estado       Estado       @relation(fields: [codigo_uf], references: [id])

  @@index([nome])
  @@index([ddd])
  @@map("cidades")
}

model ArParceira {
  id          Int      @id @default(autoincrement())
  status      Boolean  @default(true)
  ac          String?
  nome        String
  cidadeId    Int
  responsavel String?
  telefone    String?
  valor       String?
  endereco    String?
  obs         String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  cidade      Cidade   @relation(fields: [cidadeId], references: [id])
}

model Voucher {
  id            Int           @id @default(autoincrement())
  codigo        String        @unique
  produtoSoluti String?
  status        VoucherStatus @default(DISPONIVEL)
  solicitacaoId Int?
  fcw2Id        Int?
  clienteNome   String?
  clienteCpf    String?
  codVenda      String?
  dataVinculo   DateTime?
  dataUso       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  solicitacao   Solicitacao?  @relation(fields: [solicitacaoId], references: [id])
  logs          VoucherLog[]

  @@index([status])
  @@index([solicitacaoId])
}

model VoucherLog {
  id        Int      @id @default(autoincrement())
  voucherId Int
  acao      String
  descricao String?
  usuarioId Int?
  data      DateTime @default(now())
  usuario   User?    @relation(fields: [usuarioId], references: [id])
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
}

model Pagamentos {
  id               Int       @id @default(autoincrement())
  txid             String    @unique
  dt_pg            DateTime
  valor            Float
  forma_pagamento  String?
  infoPagador      String?
  nomePagador      String?
  documentoPagador String?
  banco            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?
}

enum VoucherStatus {
  DISPONIVEL
  VINCULADO
  RECICLAVEL
  UTILIZADO
  CANCELADO
}

// ═════════════════ WEBCHAT ═════════════════
enum ChatConversaStatus {
  AGUARDANDO
  EM_ATENDIMENTO
  FINALIZADA
}

enum ChatAutorTipo {
  CLIENTE
  ATENDENTE
  SISTEMA
}

enum ChatMensagemTipo {
  TEXTO
  IMAGEM
  AUDIO
  ARQUIVO
}

enum ChatVerificacaoStatus {
  PENDENTE
  CONFIRMADA
  FALHOU
  CANCELADA
}

model ChatCliente {
  id           Int       @id @default(autoincrement())
  cpf          String    @unique @db.VarChar(11) // só dígitos
  nome         String    @db.VarChar(255)
  telefone     String    @db.VarChar(13) // só dígitos, com 55
  email        String?   @db.VarChar(255)
  ultimoAcesso DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  solicitacoes ChatClienteSolicitacao[]
  dispositivos ChatDispositivo[]
  conversas    ChatConversa[]

  @@index([telefone])
}

model ChatClienteSolicitacao {
  id            Int      @id @default(autoincrement())
  clienteId     Int
  solicitacaoId Int
  vinculadoEm   DateTime @default(now())

  cliente     ChatCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id])

  @@unique([clienteId, solicitacaoId])
  @@index([solicitacaoId])
}

// Token do navegador: o token puro fica só no navegador, aqui só o SHA-256
model ChatDispositivo {
  id         Int       @id @default(autoincrement())
  clienteId  Int
  tokenHash  String    @unique @db.VarChar(64)
  verificado Boolean   @default(false)
  userAgent  String?   @db.VarChar(500)
  ip         String?   @db.VarChar(45)
  ultimoUso  DateTime  @default(now())
  expiraEm   DateTime
  revogadoEm DateTime?
  createdAt  DateTime  @default(now())

  cliente   ChatCliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensagens ChatMensagem[]
  midias    ChatMidia[]

  @@index([clienteId])
}

model ChatConversa {
  id               Int                @id @default(autoincrement())
  clienteId        Int
  solicitacaoId    Int?
  atendenteId      Int?
  status           ChatConversaStatus @default(AGUARDANDO)
  verificada       Boolean            @default(false)
  iniciadaEm       DateTime           @default(now())
  assumidaEm       DateTime?
  finalizadaEm     DateTime?
  finalizadaPorId  Int?
  ultimaMensagemEm DateTime?

  cliente       ChatCliente       @relation(fields: [clienteId], references: [id])
  solicitacao   Solicitacao?      @relation(fields: [solicitacaoId], references: [id])
  atendente     User?             @relation("ChatAtendente", fields: [atendenteId], references: [id])
  finalizadaPor User?             @relation("ChatFinalizadaPor", fields: [finalizadaPorId], references: [id])
  mensagens     ChatMensagem[]
  verificacoes  ChatVerificacao[]

  @@index([status, ultimaMensagemEm])
  @@index([clienteId])
  @@index([atendenteId])
}

model ChatMensagem {
  id            Int              @id @default(autoincrement())
  conversaId    Int
  autorTipo     ChatAutorTipo
  tipo          ChatMensagemTipo @default(TEXTO)
  atendenteId   Int? // autorTipo = ATENDENTE
  dispositivoId Int? // autorTipo = CLIENTE
  texto         String?          @db.Text // TEXTO: conteúdo | mídia: legenda opcional
  midiaId       Int?             @unique // tipo != TEXTO
  lidaEm        DateTime?
  createdAt     DateTime         @default(now())

  conversa    ChatConversa     @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  atendente   User?            @relation("ChatMensagemAtendente", fields: [atendenteId], references: [id])
  dispositivo ChatDispositivo? @relation(fields: [dispositivoId], references: [id])
  midia       ChatMidia?       @relation(fields: [midiaId], references: [id])

  @@index([conversaId, createdAt])
}

model ChatMidia {
  id            Int              @id @default(autoincrement())
  tipo          ChatMensagemTipo // IMAGEM | AUDIO | ARQUIVO
  bucket        String           @db.VarChar(100)
  chave         String           @unique @db.VarChar(255) // nome do objeto no MinIO
  mime          String           @db.VarChar(100)
  tamanho       Int // bytes
  nomeOriginal  String?          @db.VarChar(255) // ARQUIVO
  duracaoSeg    Int? // AUDIO
  largura       Int? // IMAGEM
  altura        Int? // IMAGEM
  atendenteId   Int?
  dispositivoId Int?
  createdAt     DateTime         @default(now())

  atendente   User?            @relation("ChatMidiaAtendente", fields: [atendenteId], references: [id])
  dispositivo ChatDispositivo? @relation(fields: [dispositivoId], references: [id])
  mensagem    ChatMensagem?
}

model ChatVerificacao {
  id              Int                   @id @default(autoincrement())
  conversaId      Int
  solicitadaPorId Int
  status          ChatVerificacaoStatus @default(PENDENTE)
  tentativas      Int                   @default(0)
  dispositivoId   Int?
  createdAt       DateTime              @default(now())
  respondidaEm    DateTime?

  conversa      ChatConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  solicitadaPor User         @relation("ChatVerificacaoSolicitante", fields: [solicitadaPorId], references: [id])

  @@index([conversaId, status])
}
